{
  "mcpServers": {
    "perplexity": {
      "command": "npx",
      "args": [
        "-y",
        "@perplexity-ai/mcp-server@1.3.0"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "fase-cero-youtube": {
      "command": "node",
      "args": [
        "herramientas/youtube-mcp.mjs"
      ]
    },
    "fase-cero-instagram": {
      "command": "node",
      "args": [
        "herramientas/instagram-mcp.mjs"
      ]
    }
  }
}
